# ========================================================
# SysAdmin AI Agent - Environment Configuration
# ========================================================

# LLM Provider Configuration
# Supported providers: "openai", "anthropic", "google", "ollama", "openai-compatible"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=http://localhost:11434   # Set for Ollama, vLLM, DeepSeek, or LM Studio
LLM_TEMPERATURE=0.0

# Provider-Specific API Keys (Optional fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Server Monitoring Thresholds (Percentage)
CPU_WARNING_THRESHOLD=70.0
CPU_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=80.0
MEMORY_CRITICAL_THRESHOLD=95.0
DISK_WARNING_THRESHOLD=80.0
DISK_CRITICAL_THRESHOLD=95.0

# Security Allowlist (Comma-separated)
ALLOWED_CONTAINERS=nginx-demo,redis-demo,postgres-demo
ALLOWED_SERVICES=cron,docker,ssh

# Human Approval Policy
APPROVAL_EXPIRATION_SECONDS=300

# Database Configuration
DATABASE_URL=sqlite:///./sysadmin_ai.db

# Host Observability (Set inside Docker container)
# HOST_PROC=/host/proc
# HOST_SYS=/host/sys
